{
  "name": "SafePayJet",
  "version": "1.0.0",
  "description": "An Oracle JavaScript Extension Toolkit(JET) web app",
  "dependencies": {
    "@oracle/oraclejet": "~21.0.0",
    "@oracle/oraclejet-core-pack": "~21.0.0"
  },
  "devDependencies": {
    "@oracle/ojet-cli": "~21.0.1",
    "fs-extra": "^8.1.0",
    "glob": "10.4.5",
    "typescript": "5.8.3",
    "underscore": "^1.10.2",
    "yargs-parser": "13.1.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "private": true,
  "scripts": {
    "build": "ojet build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "serve": "ojet serve --server-port=8000 --no-livereload --browser=none"
  },
  "overrides": {
    "@types/minimatch": "5.1.2"
  }
}
